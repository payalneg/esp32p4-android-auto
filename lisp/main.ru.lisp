; =============================================================================
;  main.ru.lisp — ПОСТРОЧНЫЙ РАЗБОР main.lisp НА РУССКОМ
; =============================================================================
;
;  Это НЕ рабочий скрипт для заливки, а учебная (документационная) копия
;  lisp/main.lisp: тот же код, но перед каждой строкой — объяснение, зачем она
;  нужна. Заливать в VESC Tool надо main.lisp; при правках main.lisp этот файл
;  надо обновлять руками (автосинхронизации нет).
;  Числа в квадратных скобках [N] — номер строки в оригинальном main.lisp.
;
;  ГДЕ ЭТО ВЫПОЛНЯЕТСЯ
;  Скрипт крутится на встроенном LispBM-интерпретаторе САМОГО КОНТРОЛЛЕРА VESC,
;  а не на ESP32-P4. Головное устройство (P4-дисплей) и BLE-хелпер общаются
;  с ним по CAN через COMM_CUSTOM_APP_DATA.
;
;  ЧТО ОН ДЕЛАЕТ (пять подсистем)
;   1. Арбитр мотора (motor-control-loop) — ЕДИНСТВЕННОЕ место, откуда идут
;      команды на мотор. Приоритет: мастер-выключатель > тормоз > газ > круиз >
;      педалирование (PAS) > накат.
;   2. Круиз-контроль — PI-регулятор по ERPM с выходом «ток».
;   3. Профили скорости (3 шт.) — масштабируют лимит тока и max-speed.
;   4. Сервер выезжающей панели дашборда (protocol 'VP', см. lisp/README.md).
;   5. Мелочи: бипер с громкостью в EEPROM, кнопки на пинах PPM-разъёма,
;      кнопки BLE-хелпера через «сырые» CAN-кадры.
;
;  ПОТОКИ, КОТОРЫЕ ПОДНИМАЮТСЯ (все — через spawn, вытесняющая многозадачность)
;      update-rpm-per-ms     каждые 0.2 с  — калибровка «ERPM на 1 м/с»
;      monitor-rx-button     каждые 0.05 с — кнопка RX (круиз)
;      monitor-tx-button     каждые 0.05 с — кнопка TX (профили)
;      panel-event-loop      по событиям   — панель + CAN-кнопки + shutdown
;      persist-volumes-loop  каждые 2 с    — сброс громкости бипа в EEPROM
;      motor-control-loop    каждые 0.01 с — арбитр мотора (100 Гц)
;
;  ПАМЯТКА ПО СИНТАКСИСУ LispBM (чтобы читать код ниже)
;      (def x 5)            — объявить глобальную переменную
;      (setq x 6)           — присвоить уже объявленной
;      (defun f (a) ...)    — функция
;      { a b c }            — progn: выполнить по порядку, вернуть последнее
;      (if усл то иначе)    — ветвление (иначе — необязательно)
;      (cond (усл1 ...) ...)— многоветочное ветвление
;      (let ((v выр)) ...)  — локальная переменная
;      (loopwhile t { ... })— бесконечный цикл
;      (spawn 150 f)        — запустить f отдельным потоком, стек 150 слов
;      '(кавычка)           — символ, не вычисляется: (conf-get 'l-current-max)
;
; =============================================================================


; -----------------------------------------------------------------------------
;  БЛОК 1. ГЛОБАЛЬНОЕ СОСТОЯНИЕ (всё, что меняется в рантайме)
;
;  ВАЖНО: всё, что ниже по коду присваивается через setq, обязано быть объявлено
;  ВЫШЕ строки @const-start (см. [43-48]). Иначе переменная уедет во флеш и
;  станет read-only → запись в неё роняет поток.
; -----------------------------------------------------------------------------

; [1] Флаг «круиз включён»: 0 — выключен, 1 — держим скорость.
;     Его же читает дашборд P4, чтобы зажечь индикатор круиза.
(def cruise-active 0)

; [2] Целевые обороты круиза (ERPM, со знаком: минус — задний ход).
;     Ноль, когда круиз выключен.
(def cruise-rpm 0)

; [3] Прошлое состояние кнопки на пине RX. 1 = отпущена (пин подтянут к 3.3 В),
;     0 = нажата. Нужно, чтобы ловить ФРОНТ нажатия, а не удержание.
(def rx-button-state 1)

; [4] То же самое для кнопки на пине TX.
(def tx-button-state 1)

; [5] (комментарий оригинала) Состояние арбитра мотора: всё это setq'ится
;     в рантайме, поэтому объявлено выше @const-start.

; [6] Текущий выход газа в ОТНОСИТЕЛЬНОМ токе 0..1 (доля от Motor Current Max).
;     Это состояние ограничителя скорости нарастания (slew limiter): газ не
;     прыгает мгновенно, а «доезжает» до цели по рампе.
(def out-rel 0.0)     ; throttle slew-limiter state (relative current 0..1)

; [7] То же для тормоза: текущий относительный тормозной ток 0..1.
(def brk-rel 0.0)     ; brake slew-limiter state (relative brake current 0..1)

; [8] Интегратор PI-регулятора круиза, в амперах. При включении круиза в него
;     кладут фактический ток мотора — это и есть «безударное» (bumpless)
;     включение: выход регулятора в первый же тик равен тому, что уже было.
(def cruise-i 0.0)    ; cruise PI integrator (A), seeded on activation (bumpless)

; [9] Флаг безопасного старта: 0 — газ ещё ни разу не видели отпущенным после
;     запуска скрипта, поэтому выход газа принудительно нулевой. Защита от
;     «залипшей» или зажатой ручки в момент старта.
(def armed 0)         ; safe-start: throttle must be seen released once after boot

; [10-13] (комментарий оригинала) Коэффициенты PI круиза захардкожены здесь:
;     штатные s-pid-kp/ki из VESC Tool в LISP через conf-get НЕ доступны, читать
;     их неоткуда. А вот времена рамп (ramping) читаются живьём из VESC Tool —
;     см. throttle-out/brake-out.

; [14] Пропорциональный коэффициент круиза: сколько ампер на 1 ERPM ошибки.
;     Больше — резче реакция, но склонность к раскачке.
(def cruise-kp 0.02)  ; cruise PI: A per ERPM of error

; [15] Интегральный коэффициент: сколько ампер в секунду накапливать на 1 ERPM
;     ошибки. Он убирает статическую ошибку (например, на подъёме).
(def cruise-ki 0.05)  ; cruise PI: A/s per ERPM of error

; [16-18] (комментарий оригинала) Почему период именно 100 Гц: на 20 Гц рампа
;     шагала по 12.5% максимального тока за тик, а FOC-контур отрабатывает шаг
;     мгновенно → на ощупь это рывки, а не плавный разгон (как в vl_bike Веддера).

; [19] Период тика арбитра в секундах: 0.01 с = 100 Гц. На него же завязан
;     пересчёт рамп и интегрирование круиза, так что менять — только осознанно.
(def ctl-dt 0.01)          ; arbiter period (s)

; [20] Кривая газа: коэффициент «остроты», -1..1. 0 = линейно, минус = мягче
;     в начале хода, плюс = агрессивнее. Такая же кривая, как в VESC Tool.
(def thr-curve-accel 0.0)  ; throttle-curve accel const, -1..1 (0 = linear)

; [21] Тип кривой газа: 0 — экспоненциальная, 1 — «натуральная», 2 — полином.
(def thr-curve-mode 0)     ; 0 exponential, 1 natural, 2 polynomial

; [22] Индекс активного профиля скорости: 0 / 1 / 2.
(def current-profile 0)

; [23] Сколько всего профилей — по нему switch-profile заворачивает счётчик.
(def num-profiles 3)

; [24] Флаг «первое применение профиля при загрузке». Нужен, чтобы при старте
;     скрипта профиль применился МОЛЧА, без приветственного бипа.
(def first-profile-init 1)

; [25] Калибровочный коэффициент: сколько ERPM приходится на 1 м/с. Считается
;     на ходу (см. update-rpm-per-ms) и позволяет менять скорость круиза
;     шагами по 1 км/ч, не зная передаточного числа/диаметра колеса.
(def rpm-per-ms 0.0)

; [26] Мастер-выключатель газа с панели: 1 — едем, 0 — арбитр держит ток в нуле
;     (накат). Работает и как «блокировка» на стоянке.
(def throttle-on 1)

; [27] Флаг антипробуксовки (traction control). Сейчас всегда 0: контрол панели
;     для него не выведен, а на одномоторной машине смысла мало.
(def tc-on 0)

; [28] Чувствительность антипробуксовки 0..100 (входит в формулу порога в
;     monitor-traction).
(def tc-sens 50.0)

; [29] Рабочий буфер на 128 байт, в котором СОБИРАЮТСЯ ответы панели.
;     Создан один раз и переиспользуется. Обязан быть выше @const-start:
;     буфер, уехавший во флеш, доступен только на чтение, и bufset его уронит.
(def pbuf (bufcreate 128))

; [30] Курсор записи в pbuf: индекс следующего свободного байта. Каждый ответ
;     начинается с (setq pi 0), дальше pu8/pi32/pstr двигают его сами.
(def pi 0)

; [31] Адрес ячейки EEPROM (номер слота, не байт), где хранится громкость бипа.
(def beep-vol-addr 0)

; [32] Громкость бипа. Читаем из EEPROM при загрузке скрипта...
(def beep-vol (let ((v (eeprom-read-i beep-vol-addr)))
; [33] ...и если там мусор (nil / вне диапазона 0..50), берём дефолт 30.
                (if (and v (>= v 0) (<= v 50)) v 30)))

; [34] «Громкость изменена, но ещё не записана во флеш». Ставится при кручении
;     слайдера, сбрасывается фоновым persist-volumes-loop раз в 2 с — так драг
;     слайдера превращается примерно в одну запись во флеш, а не в сотню.
(def beep-vol-dirty 0)

; [35-39] (комментарий оригинала) Уставка педалирования (PAS), приходит от
;     головного устройства / BLE-хелпера сообщением 0x05 поверх
;     COMM_CUSTOM_APP_DATA. Всё это setq'ится → обязано быть выше @const-start.

; [40] Запрошенный ток педалирования в амперах (0 = помощи нет).
(def pas-amps 0.0)

; [41] Метка времени (systime) последнего принятого PAS-кадра — по ней
;     проверяется «протухание» уставки (свежее 0.4 с).
(def pas-seen 0)

; [42] CAN-id узла, на который мы «залочились» как на источник PAS.
;     -1 = ни на кого; зачем лок — подробно в обработчике 0x05 ниже.
(def pas-src -1)

; [43-47] (комментарий оригинала) @const-start «прошивает» (кладёт во флеш)
;     всё, что определено ниже, и тем самым освобождает кучу cons-ячеек. Без
;     него тела всех defun лежат в RAM и съедают кучу: panel-event-loop потом
;     падает по OOM в рантайме, экран гаснет, а управление мотором продолжает
;     работать (то есть симптом крайне неочевидный).

; [48] Начало «флешируемой» области. Всё изменяемое — строго выше.
@const-start


; -----------------------------------------------------------------------------
;  БЛОК 2. ПРОФИЛИ СКОРОСТИ И ЗВУК
; -----------------------------------------------------------------------------

; [49] Хелпер: «пикнуть коротко». Запускается отдельным потоком, чтобы sleep
;     внутри не тормозил вызывающего.
(defun play-stop () {
;   [50] Держим тон 100 мс...
    (sleep 0.1)
;   [51] ...и глушим генератор тона FOC.
    (foc-play-stop)
;   [52] Конец progn / конец функции.
})

; [53-55] (комментарий оригинала) Профиль МАСШТАБИРУЕТ лимит тока, а не
;     перезаписывает его: Motor Current Max в VESC Tool остаётся главным
;     значением (применяется живьём, без перезапуска LISP), а профиль — это его
;     доля. Торможение никогда не масштабируется — всегда на полную.

; [56] Применить профиль по индексу 0/1/2: выставить максимальную скорость,
;     долю тока и (кроме самого первого раза) пикнуть.
(defun apply-profile (profile-index) {
;   [57] Ветка «профиль 0».
    (if (= profile-index 0) {
;       [58] max-speed задаётся в м/с, поэтому 25 км/ч делим на 3.6.
        (conf-set 'max-speed (/ 25.0 3.6))
;       [59] Половина от Motor Current Max.
        (conf-set 'l-current-max-scale 0.5)
;       [60] Печать в консоль LISP (видна в VESC Tool и в веб-редакторе).
        (print "Profile 0: Slow (25 km/h, 50% current)")
;   [61] Иначе — проверяем следующие профили (вложенные if вместо cond).
    } {
;       [62] Ветка «профиль 1».
        (if (= profile-index 1) {
;           [63] 40 км/ч → м/с.
            (conf-set 'max-speed (/ 40.0 3.6))
;           [64] 67% тока.
            (conf-set 'l-current-max-scale 0.67)
;           [65] Лог.
            (print "Profile 1: Medium (40 km/h, 67% current)")
;       [66] Иначе — проверяем профиль 2.
        } {
;           [67] Ветка «профиль 2».
            (if (= profile-index 2) {
;               [68] 60 км/ч → м/с.
                (conf-set 'max-speed (/ 60.0 3.6))
;               [69] Полный ток (масштаб 1.0).
                (conf-set 'l-current-max-scale 1.0)
;               [70] Лог.
                (print "Profile 2: Fast (60 km/h, 100% current)")
;           [71] Закрытие if профиля 2 (несуществующий индекс просто игнорится).
            })
;       [72] Закрытие иначе-ветки профиля 1.
        })
;   [73] Закрытие иначе-ветки профиля 0.
    })
;   [74] Звуковое подтверждение — только если это НЕ первое применение при
;       загрузке скрипта (иначе устройство бы пищало на каждой перезагрузке).
    (if (= first-profile-init 0) {
;       [75] Частота бипа зависит от профиля: чем быстрее профиль, тем выше тон.
        (let ((beep-freq (if (= profile-index 0) {
;           [76] Профиль 0 → 500 Гц.
            500
;       [77] Иначе...
        } {
;           [78] ...профиль 1...
            (if (= profile-index 1) {
;               [79] ...→ 750 Гц.
                750
;           [80] Иначе...
            } {
;               [81] ...профиль 2 → 1000 Гц.
                1000
;           [82] Закрытие внутреннего if.
            })
;       [83] Закрытие внешнего if и начало тела let.
        }))) {
;           [84] Стартуем тон через FOC-модуляцию мотора (канал 0, громкость 10
;               фиксированная — это подтверждение профиля, не панельный бип).
            (foc-play-tone 0 beep-freq 10)
;           [85] И отдельным потоком глушим его через 100 мс, чтобы не блокировать
;               вызывающий поток (кнопку/панель).
            (spawn 150 play-stop)
;       [86] Конец тела let.
        })
;   [87] Иначе (это самый первый вызов при загрузке)...
    } {
;       [88] ...просто снимаем флаг: со следующего раза уже будем пищать.
        (setq first-profile-init 0)
;   [89] Закрытие if.
    })
; [90] Конец функции apply-profile.
})

; [91] Пин RX PPM-разъёма настраиваем как ВХОД с подтяжкой к питанию. Кнопка
;     замыкает его на землю → нажатие читается как 0. (Это не defun, а обычное
;     выражение — выполняется прямо во время загрузки скрипта.)
(gpio-configure 'pin-rx 'pin-mode-in-pu)

; [92] То же для пина TX — вторая кнопка.
(gpio-configure 'pin-tx 'pin-mode-in-pu)


; -----------------------------------------------------------------------------
;  БЛОК 3. КРУИЗ-КОНТРОЛЬ
; -----------------------------------------------------------------------------

; [93] Фоновый поток: пока круиз выключен, вычисляет коэффициент «ERPM на 1 м/с».
;     Он нужен, чтобы кнопками менять скорость круиза шагами по 1 км/ч.
(defun update-rpm-per-ms () {
;   [94] Крутимся вечно.
    (loopwhile t {
;       [95] Считаем только при выключенном круизе: во время круиза cruise-rpm
;           задан вручную, и пересчёт только испортил бы калибровку.
        (if (= cruise-active 0) {
;           [96] Текущие обороты мотора (ERPM).
            (let ((current-rpm (get-rpm))) {
;               [97] Текущая скорость по данным прошивки (м/с).
                (let ((current-speed-ms (get-speed))) {
;                   [98] Обновляем только на осмысленном ходу: >10 ERPM и
;                       >0.1 м/с, иначе деление даст мусор.
                    (if (and (> (abs current-rpm) 10) (> (abs current-speed-ms) 0.1)) {
;                       [99] Собственно коэффициент = |ERPM| / |м/с|.
                        (setq rpm-per-ms (/ (abs current-rpm) (abs current-speed-ms)))
;                   [100] Закрытие if.
                    })
;               [101] Закрытие let скорости.
                })
;           [102] Закрытие let оборотов.
            })
;       [103] Закрытие if.
        })
;       [104] Пять раз в секунду достаточно — это медленная калибровка.
        (sleep 0.2)
;   [105] Конец цикла.
    })
; [106] Конец функции.
})

; [107-111] (комментарий оригинала) Круиз здесь — это PI-регулятор скорости
;     с выходом «ТОК», живущий внутри арбитра мотора, а НЕ штатный speed-PID
;     прошивки. Никакого переключения в режим set-rpm нет, поэтому включение не
;     может дёрнуть: интегратор инициализируется фактическим током, и контур
;     дальше плавно командует током. Функции ниже только переключают состояние —
;     всю работу делает motor-control-loop.

; [112] Включить круиз (вызывается по кнопке RX).
(defun activate-cruise-control () {
;   [113] Только если круиз ещё не активен И мастер-выключатель газа включён.
    (if (and (= cruise-active 0) (= throttle-on 1)) {
;       [114] Запоминаем текущие обороты как целевые.
        (setq cruise-rpm (get-rpm))
;       [115] На нуле скорости круиз бессмысленен — проверяем.
        (if (> (abs cruise-rpm) 0) {
;           [116] Ключевая строка «безударности»: интегратор = фактический ток
;               мотора прямо сейчас, поэтому первый выход регулятора совпадёт
;               с тем, что уже едет.
            (setq cruise-i (get-current))   ; bumpless transfer
;           [117] Взводим флаг — со следующего тика арбитр отдаёт мотор круизу.
            (setq cruise-active 1)
;           [118] Лог с целевыми оборотами.
            (print (str-merge "Cruise control activated at RPM: " (to-str cruise-rpm)))
;       [119] Иначе (стоим на месте)...
        } {
;           [120] ...просто сообщаем, что включать нечего.
            (print "Cannot activate cruise control: speed is zero")
;       [121] Закрытие if по оборотам.
        })
;   [122] Закрытие внешнего if.
    })
; [123] Конец функции.
})

; [124] Выключить круиз (вызывается кнопкой, газом, тормозом, мастер-выключателем).
(defun deactivate-cruise-control () {
;   [125] Только если он вообще был включён — чтобы не спамить логом.
    (if (= cruise-active 1) {
;       [126] Снимаем флаг: арбитр перестанет отдавать мотор круизу.
        (setq cruise-active 0)
;       [127] Обнуляем целевые обороты.
        (setq cruise-rpm 0)
;       [128] И сбрасываем калибровку ERPM/м-с, чтобы она пересчиталась заново
;           (update-rpm-per-ms снова начнёт работать, раз круиз выключен).
        (setq rpm-per-ms 0.0)
;       [129] Лог.
        (print "Cruise control deactivated")
;   [130] Закрытие if.
    })
; [131] Конец функции.
})

; [132] +1 км/ч к скорости круиза (повторное нажатие кнопки RX при активном круизе).
(defun increase-cruise-speed () {
;   [133] Работает только при включённом круизе.
    (if (= cruise-active 1) {
;       [134] Если калибровка ERPM/(м/с) есть — считаем «по-человечески», в км/ч.
        (if (> rpm-per-ms 0.0) {
;           [135] Текущая целевая скорость в м/с = |целевые ERPM| / коэффициент.
            (let ((current-speed-ms (/ (abs cruise-rpm) rpm-per-ms))) {
;               [136] Прибавляем ровно 1 км/ч (1/3.6 м/с).
                (let ((new-speed-ms (+ current-speed-ms (/ 1.0 3.6)))) {
;                   [137] И переводим обратно в ERPM.
                    (let ((new-rpm (* new-speed-ms rpm-per-ms))) {
;                       [138] Если ехали назад (cruise-rpm < 0)...
                        (if (< cruise-rpm 0) {
;                           [139] ...то «быстрее» означает больший модуль с минусом.
                            (setq cruise-rpm (- new-rpm))
;                       [140] Иначе...
                        } {
;                           [141] ...просто новое положительное значение.
                            (setq cruise-rpm new-rpm)
;                       [142] Закрытие if по знаку.
                        })
;                       [143] Лог.
                        (print (str-merge "Cruise speed increased to RPM: " (to-str cruise-rpm)))
;                   [144] Закрытие let new-rpm.
                    })
;               [145] Закрытие let new-speed-ms.
                })
;           [146] Закрытие let current-speed-ms.
            })
;       [147] Иначе — калибровки нет (например, датчик скорости молчит)...
        } {
;           [148] ...тогда шагаем «вслепую» фиксированными 50 ERPM.
            (let ((rpm-increment 50)) {
;               [149] Задний ход — вычитаем (растёт модуль).
                (if (< cruise-rpm 0) {
;                   [150] Быстрее назад.
                    (setq cruise-rpm (- cruise-rpm rpm-increment))
;               [151] Иначе...
                } {
;                   [152] ...вперёд — прибавляем.
                    (setq cruise-rpm (+ cruise-rpm rpm-increment))
;               [153] Закрытие if по знаку.
                })
;               [154] Лог.
                (print (str-merge "Cruise speed increased to RPM: " (to-str cruise-rpm)))
;           [155] Закрытие let.
            })
;       [156] Закрытие if «есть ли калибровка».
        })
;   [157] Закрытие if «круиз активен».
    })
; [158] Конец функции.
})

; [159] Поток опроса кнопки на пине RX: короткое нажатие = включить круиз, а если
;     он уже включён — прибавить 1 км/ч.
(defun monitor-rx-button () {
;   [160] Вечный цикл опроса (программный поллинг, без прерываний).
    (loopwhile t {
;       [161] Читаем пин: 1 = отпущена, 0 = нажата (подтяжка вверх).
        (let ((current-button-state (gpio-read 'pin-rx))) {
;           [162] Ловим именно ФРОНТ 1→0, чтобы удержание не считалось серией нажатий.
            (if (and (= rx-button-state 1) (= current-button-state 0)) {
;               [163] Если круиз уже держит скорость...
                (if (= cruise-active 1) {
;                   [164] ...то нажатие = «+1 км/ч».
                    (increase-cruise-speed)
;               [165] Иначе...
                } {
;                   [166] ...нажатие = «зафиксировать текущую скорость».
                    (activate-cruise-control)
;               [167] Закрытие внутреннего if.
                })
;           [168] Закрытие if фронта.
            })
;           [169] Запоминаем состояние для следующей итерации (детектор фронта).
            (setq rx-button-state current-button-state)
;       [170] Закрытие let.
        })
;       [171] 20 Гц опроса — заодно работает как антидребезг.
        (sleep 0.05)
;   [172] Конец цикла.
    })
; [173] Конец функции.
})

; [174] Переключить профиль по кругу (кнопка TX).
(defun switch-profile () {
;   [175] Следующий индекс.
    (setq current-profile (+ current-profile 1))
;   [176] Если вышли за последний...
    (if (>= current-profile num-profiles) {
;       [177] ...заворачиваемся на нулевой.
        (setq current-profile 0)
;   [178] Закрытие if.
    })
;   [179] Применяем — тут же меняются max-speed, лимит тока и звучит бип.
    (apply-profile current-profile)
; [180] Конец функции.
})

; [181-184] (комментарий оригинала) Прямой выбор профиля — его дёргают кнопки
;     на экранной панели (кнопка TX по-прежнему циклит через switch-profile).
;     Выбор УЖЕ активного профиля — no-op: на панели это радиогруппа, и тап по
;     горящей строке просто зажжётся заново из ответа STATE, а не выключится.

; [185] Выбрать профиль по индексу (0..num-profiles-1).
(defun panel-set-profile (idx) {
;   [186] Проверяем границы И что профиль реально меняется.
    (if (and (>= idx 0) (< idx num-profiles) (not (= idx current-profile))) {
;       [187] Запоминаем.
        (setq current-profile idx)
;       [188] Применяем (с бипом-подтверждением).
        (apply-profile current-profile)
;   [189] Закрытие if.
    })
; [190] Конец функции.
})

; [191] −1 км/ч к скорости круиза (кнопка TX при активном круизе). Зеркало
;     increase-cruise-speed, но с защитой от ухода в ноль.
(defun decrease-cruise-speed () {
;   [192] Только при активном круизе.
    (if (= cruise-active 1) {
;       [193] Если калибровка есть — считаем в км/ч.
        (if (> rpm-per-ms 0.0) {
;           [194] Текущая целевая скорость, м/с.
            (let ((current-speed-ms (/ (abs cruise-rpm) rpm-per-ms))) {
;               [195] Минус 1 км/ч.
                (let ((new-speed-ms (- current-speed-ms (/ 1.0 3.6)))) {
;                   [196] Если после вычитания ещё есть осмысленный ход (>0.1 м/с)...
                    (if (> new-speed-ms 0.1) {
;                       [197] ...переводим в ERPM.
                        (let ((new-rpm (* new-speed-ms rpm-per-ms))) {
;                           [198] Учитываем знак (задний ход).
                            (if (< cruise-rpm 0) {
;                               [199] Назад — отрицательное значение.
                                (setq cruise-rpm (- new-rpm))
;                           [200] Иначе...
                            } {
;                               [201] ...вперёд.
                                (setq cruise-rpm new-rpm)
;                           [202] Закрытие if по знаку.
                            })
;                           [203] Лог.
                            (print (str-merge "Cruise speed decreased to RPM: " (to-str cruise-rpm)))
;                       [204] Закрытие let new-rpm.
                        })
;                   [205] Иначе — тормозить круизом дальше некуда...
                    } {
;                       [206] ...просто выключаем круиз (машина покатится накатом).
                        (deactivate-cruise-control)
;                       [207] Лог с причиной.
                        (print "Cruise control deactivated: speed too low")
;                   [208] Закрытие if по минимальной скорости.
                    })
;               [209] Закрытие let new-speed-ms.
                })
;           [210] Закрытие let current-speed-ms.
            })
;       [211] Иначе — калибровки нет...
        } {
;           [212] ...в отличие от «плюса», здесь безопаснее выключить круиз,
;               чем угадывать шаг вниз.
            (deactivate-cruise-control)
;           [213] Лог с причиной.
            (print "Cruise control deactivated: no speed ratio available")
;       [214] Закрытие if «есть калибровка».
        })
;   [215] Закрытие if «круиз активен».
    })
; [216] Конец функции.
})

; [217] Поток опроса кнопки TX: без круиза — переключает профиль, при круизе —
;     сбрасывает 1 км/ч.
(defun monitor-tx-button () {
;   [218] Вечный цикл.
    (loopwhile t {
;       [219] Читаем пин TX.
        (let ((current-button-state (gpio-read 'pin-tx))) {
;           [220] Фронт «отпущена → нажата».
            (if (and (= tx-button-state 1) (= current-button-state 0)) {
;               [221] При активном круизе...
                (if (= cruise-active 1) {
;                   [222] ...кнопка означает «медленнее».
                    (decrease-cruise-speed)
;               [223] Иначе...
                } {
;                   [224] ...кнопка означает «следующий профиль».
                    (switch-profile)
;               [225] Закрытие внутреннего if.
                })
;           [226] Закрытие if фронта.
            })
;           [227] Сохраняем состояние для детектора фронта.
            (setq tx-button-state current-button-state)
;       [228] Закрытие let.
        })
;       [229] 20 Гц.
        (sleep 0.05)
;   [230] Конец цикла.
    })
; [231] Конец функции.
})

; [232] Применяем профиль 0 при загрузке скрипта. Первый вызов — молчаливый:
;     first-profile-init = 1 гасит бип и сбрасывается сам.
(apply-profile 0)

; [233] Поднимаем поток калибровки ERPM/(м/с). Число 150 — размер стека потока.
(spawn 150 update-rpm-per-ms)

; [234] Поднимаем поток кнопки RX (круиз).
(spawn 150 monitor-rx-button)

; [235] Поднимаем поток кнопки TX (профили).
(spawn 150 monitor-tx-button)


; -----------------------------------------------------------------------------
;  БЛОК 4. ПАНЕЛЬ ДАШБОРДА (протокол 'VP', подробности — в lisp/README.md)
;
;  Идея: панель ДАННО-УПРАВЛЯЕМАЯ. Прошивка P4 не знает, какие там контролы;
;  она спрашивает «опиши свои контролы» (0x01), получает список (0x81) и рисует
;  его. Дальше раз в ~200 мс запрашивает значения (0x03 → 0x82), а по тапу шлёт
;  ACTION (0x02) и получает обратно свежий STATE.
;
;  Все числа едут как int32 = значение × 1000, big-endian. Строки — с нулевым
;  байтом на конце (в LispBM строковый литерал уже содержит его, и buflen его
;  считает).
; -----------------------------------------------------------------------------

; [236] Дописать один байт в pbuf и сдвинуть курсор pi на 1.
(defun pu8  (v) { (bufset-u8  pbuf pi v) (setq pi (+ pi 1)) })

; [237] Дописать int32 (big-endian) и сдвинуть курсор на 4. to-i32 нужен, потому
;     что на вход обычно приходит float после умножения на 1000.
(defun pi32 (v) { (bufset-i32 pbuf pi (to-i32 v)) (setq pi (+ pi 4)) })

; [238] Дописать строку вместе с завершающим нулём (buflen у строки считает его).
(defun pstr (s) { (bufcpy pbuf pi s 0 (buflen s)) (setq pi (+ pi (buflen s))) })

; [239] Ответ на REQ_UI (0x01): описание всех контролов панели. reply-id — это
;     CAN-id спрашивающего (P4), в который мы шлём ответ.
(defun panel-send-ui (reply-id) {
;   [240] Сбрасываем курсор — пишем ответ с начала буфера.
    (setq pi 0)
;   [241] Заголовок: 'V' 'P', тип 0x81 (UI_DESC), версия формата 1, число
;       контролов 6. Счётчик ОБЯЗАН совпадать с реально перечисленными ниже.
    (pu8 0x56) (pu8 0x50) (pu8 0x81) (pu8 1) (pu8 6)
;   [242] Контрол 1: id=1, тип 1 (toggle), надпись "Throttle", текущее состояние.
    (pu8 1) (pu8 1) (pstr "Throttle") (pu8 (if (= throttle-on 1) 1 0))
;   [243] Контрол 2: id=4, тип 2 (button) — «пикнуть»; у кнопки хвоста нет.
    (pu8 4) (pu8 2) (pstr "Beep")
;   [244] Контрол 3: id=5, тип 3 (number) — громкость бипа.
    (pu8 5) (pu8 3) (pstr "Beep Vol")
;   [245] Хвост number: min=0, max=50, шаг=5, текущее значение, единица (пусто).
;       Всё ×1000, потому и 50000 / 5000.
    (pi32 0) (pi32 50000) (pi32 5000) (pi32 (* beep-vol 1000)) (pstr "")
;   [246-247] (комментарий оригинала) Радиогруппа профилей (id 10..12): горит
;       ровно один, тап по строке выбирает профиль. Надписи держать в
;       соответствии с apply-profile.
;   [248] Профиль 0 — toggle, горит если current-profile = 0.
    (pu8 10) (pu8 1) (pstr "Slow 25 km/h")   (pu8 (if (= current-profile 0) 1 0))
;   [249] Профиль 1.
    (pu8 11) (pu8 1) (pstr "Medium 40 km/h") (pu8 (if (= current-profile 1) 1 0))
;   [250] Профиль 2.
    (pu8 12) (pu8 1) (pstr "Fast 60 km/h")   (pu8 (if (= current-profile 2) 1 0))
;   [251] Отправляем весь буфер: интерфейс 2 = CAN, адресат = reply-id.
;       (Явная форма send-data требует прошивку VESC 6.05+.)
    (send-data pbuf 2 reply-id)
; [252] Конец функции.
})

; [253] Ответ на REQ_STATE (0x03): только живые значения, без описаний. Панель
;     дёргает его ~5 раз в секунду, пока открыта, и после каждого ACTION.
(defun panel-send-state (reply-id) {
;   [254] Курсор в начало.
    (setq pi 0)
;   [255] Заголовок: 'V' 'P', тип 0x82 (STATE), число записей 5 (у кнопки Beep
;       состояния нет, поэтому её здесь нет: 6 контролов − 1 кнопка).
    (pu8 0x56) (pu8 0x50) (pu8 0x82) (pu8 5)
;   [256] id 1 (Throttle) → 0 или 1, ×1000.
    (pu8 1) (pi32 (* (if (= throttle-on 1) 1 0) 1000))
;   [257] id 5 (Beep Vol) → громкость ×1000.
    (pu8 5) (pi32 (* beep-vol 1000))
;   [258] id 10 — горит ли «Slow».
    (pu8 10) (pi32 (* (if (= current-profile 0) 1 0) 1000))
;   [259] id 11 — «Medium».
    (pu8 11) (pi32 (* (if (= current-profile 1) 1 0) 1000))
;   [260] id 12 — «Fast».
    (pu8 12) (pi32 (* (if (= current-profile 2) 1 0) 1000))
;   [261] Отправка по CAN адресату.
    (send-data pbuf 2 reply-id)
; [262] Конец функции.
})

; [263] Ответ на 0x04 — «телеметрия дашборда»: фиксированный набор из четырёх
;     чисел, без id и без счётчика (формат жёстко зашит и на стороне P4).
(defun panel-send-dash (reply-id) {
;   [264] Курсор в начало.
    (setq pi 0)
;   [265] Заголовок: 'V' 'P', тип 0x84 (DASH).
    (pu8 0x56) (pu8 0x50) (pu8 0x84)
;   [266] Флаг круиза (0/1) ×1000 — по нему дашборд зажигает индикатор.
    (pi32 (* cruise-active 1000))
;   [267] Целевые обороты круиза ×1000.
    (pi32 (* cruise-rpm 1000))
;   [268] Индекс активного профиля ×1000.
    (pi32 (* current-profile 1000))
;   [269] Калибровка ERPM на м/с ×1000 (дашборд может показать скорость круиза
;       в км/ч, поделив cruise-rpm на этот коэффициент).
    (pi32 (* rpm-per-ms 1000.0))
;   [270] Отправка.
    (send-data pbuf 2 reply-id)
; [271] Конец функции.
})

; [272-273] (комментарий оригинала) Мастер-выключатель теперь просто флаг: всем
;     выходом владеет арбитр мотора, и при throttle-on = 0 он катится накатом
;     (set-current 0). Никакой возни с включением/выключением ADC-приложения.

; [274] Включить/выключить газ с панели.
(defun panel-set-throttle (on) {
;   [275] Если выключают...
    (if (= on 0) {
;       [276] ...сначала гасим круиз (иначе он продолжал бы «держать» скорость
;           в собственной ветке арбитра).
        (if (= cruise-active 1) (deactivate-cruise-control))
;       [277] И опускаем флаг — арбитр уйдёт в накат.
        (setq throttle-on 0)
;   [278] Иначе...
    } {
;       [279] ...просто разрешаем управление.
        (setq throttle-on 1)
;   [280] Закрытие if.
    })
; [281] Конец функции.
})

; [282] Звуковая последовательность «би-бип … би-бип» для кнопки Beep на панели.
;     Играется через мотор (foc-play-tone), громкость — из beep-vol.
(defun two-beeps () {
;   [283] Первый тон 800 Гц.
    (foc-play-tone 0 800 beep-vol)
;   [284] Держим 100 мс.
    (sleep 0.1)
;   [285] Тишина.
    (foc-play-stop)
;   [286] Короткая пауза между тонами.
    (sleep 0.06)
;   [287] Второй тон повыше — 900 Гц.
    (foc-play-tone 0 900 beep-vol)
;   [288] Держим.
    (sleep 0.1)
;   [289] Стоп.
    (foc-play-stop)
;   [290] Пауза между парами (0.3 с — чтобы это читалось как два «би-бип»).
    (sleep 0.3)
;   [291] Повтор пары: 800 Гц...
    (foc-play-tone 0 800 beep-vol)
;   [292] ...держим...
    (sleep 0.1)
;   [293] ...стоп...
    (foc-play-stop)
;   [294] ...пауза...
    (sleep 0.06)
;   [295] ...900 Гц...
    (foc-play-tone 0 900 beep-vol)
;   [296] ...держим...
    (sleep 0.1)
;   [297] ...и глушим окончательно.
    (foc-play-stop)
; [298] Конец функции.
})

; [299] (комментарий оригинала) Запускаем последовательность отдельным потоком,
;     чтобы её sleep'ы (в сумме ~0.8 с) не блокировали panel-event-loop.

; [300] Обёртка для кнопки Beep: только породить поток и сразу вернуться.
(defun panel-beep () (spawn 150 two-beeps))

; [301] Диспетчер действий панели: cid — id контрола, val — новое значение
;     (уже поделённое на 1000, то есть в реальных единицах).
(defun panel-action (cid val) {
;   [302] Многоветочный выбор по id контрола.
    (cond
;       [303] id 1 — toggle «Throttle»: >0.5 считается «включено».
        ((= cid 1) (panel-set-throttle (if (> val 0.5) 1 0)))
;       [304] id 4 — кнопка «Beep».
        ((= cid 4) (panel-beep))
;       [305] id 5 — число «Beep Vol».
        ((= cid 5) {
;           [306] Сохраняем как целое (0..50).
            (setq beep-vol (to-i32 val))
;           [307] Помечаем «надо записать в EEPROM» — сама запись отложена
;               (persist-volumes-loop), чтобы драг слайдера не насиловал флеш.
            (setq beep-vol-dirty 1)
;       [308] Закрытие ветки.
        })
;       [309-310] (комментарий оригинала) Радиогруппа профилей: сам id говорит,
;           какой профиль выбран, поэтому val игнорируется (тап по уже горящей
;           строке приходит со значением 0, а panel-set-profile его проглотит).
;       [311] id 10 → профиль 0.
        ((= cid 10) (panel-set-profile 0))
;       [312] id 11 → профиль 1.
        ((= cid 11) (panel-set-profile 1))
;       [313] id 12 → профиль 2.
        ((= cid 12) (panel-set-profile 2)))
; [314] Конец функции.
})

; [315] Разбор входящего кадра COMM_CUSTOM_APP_DATA. data — байтовый буфер
;     БЕЗ самого байта команды (его снимает прошивка).
(defun panel-handle (data) {
;   [316] Минимальная валидация: длина хотя бы 4 байта...
    (if (and (>= (buflen data) 4)
;       [317] ...первый байт 'V' (0x56)...
             (= (bufget-u8 data 0) 0x56)
;       [318] ...второй 'P' (0x50). Чужие кадры молча игнорируем.
             (= (bufget-u8 data 1) 0x50))
;       [319] Байт 2 — тип сообщения.
        (let ((msg (bufget-u8 data 2))
;           [320] Байт 3 — CAN-id отправителя, куда слать ответ.
              (reply-id (bufget-u8 data 3))) {
;           [321] Диспетчер по типу сообщения.
            (cond
;               [322] 0x01 REQ_UI — «опиши свои контролы».
                ((= msg 0x01) (panel-send-ui reply-id))
;               [323] 0x03 REQ_STATE — «дай текущие значения».
                ((= msg 0x03) (panel-send-state reply-id))
;               [324] 0x04 REQ_DASH — «дай телеметрию круиза/профиля».
                ((= msg 0x04) (panel-send-dash reply-id))
;               [325] 0x05 — уставка педалирования (PAS).
                ((= msg 0x05) {
;                   [326-336] (комментарий оригинала) Кадр без ответа. i32 в
;                       миллиамперах лежит с байта 4 (после magic[0,1], msg[2],
;                       reply-id[3]).
;
;                       ЛОК НА ИСТОЧНИК: уставки может слать больше одного узла
;                       (PAS на самом P4-дисплее на прошивках до 1.3.1 вечно
;                       шлёт 0 А с частотой 20 Гц). Вперемешку с реальным током
;                       эти нули рубят pas-amps в 3→0→3→0 и мотор дёргается.
;                       Поэтому: залочиться на того, кто прислал последнюю
;                       НЕНУЛЕВУЮ уставку (reply-id = его CAN-id), и игнорировать
;                       остальных, пока источник не замолчит или не пришлёт 0.
;                       Ноль от залоченного источника снимает лок; протухание
;                       (0.4 с) — тоже.
;                   [337] Читаем i32 (big-endian) и переводим мА → А.
                    (let ((amps (/ (bufget-i32 data 4) 1000.0)))
;                       [338] Принимаем кадр, если он от залоченного источника...
                        (if (or (= pas-src reply-id)
;                           [339] ...или лока сейчас нет...
                                (= pas-src -1)
;                           [340] ...или прошлый источник молчит дольше 0.4 с.
                                (> (secs-since pas-seen) 0.4))
;                           [341] Начало «принять» ветки.
                            {
;                               [342] Сохраняем запрошенный ток.
                                (setq pas-amps amps)
;                               [343] Отмечаем момент приёма (для проверки свежести).
                                (setq pas-seen (systime))
;                               [344] Ненулевая уставка → лочимся на отправителя,
;                                   нулевая → отпускаем лок.
                                (setq pas-src (if (> amps 0.0) reply-id -1))
;                           [345] Конец ветки «принять».
                            }
;                           [346] Иначе — кадр от чужого узла, молча выбрасываем.
                            nil))
;               [347] Закрытие ветки 0x05.
                })
;               [348] 0x06 — атомарное переключение газа.
                ((= msg 0x06) {
;                   [349-351] (комментарий оригинала) Команда от BLE-хелпера (его
;                       GUI / throttle_ctl): переключаем СВОЁ состояние — знать
;                       его отправителю не нужно — и отвечаем свежим STATE.
;                   [352] Инвертируем мастер-выключатель.
                    (panel-set-throttle (if (= throttle-on 1) 0 1))
;                   [353] Сразу шлём новое состояние, чтобы UI отправителя обновился.
                    (panel-send-state reply-id)
;               [354] Закрытие ветки 0x06.
                })
;               [355] 0x02 ACTION — пользователь тапнул контрол.
                ((= msg 0x02)
;                   [356] Байт 4 — id контрола.
                    (let ((cid (bufget-u8 data 4))
;                       [357] Байты 5..8 — значение ×1000, делим обратно.
                          (val (/ (bufget-i32 data 5) 1000.0))) {
;                       [358] Выполняем действие.
                        (panel-action cid val)
;                       [359] И эхом возвращаем применённое состояние — на этом
;                           держится, например, поведение радиогруппы.
                        (panel-send-state reply-id)
;                   [360] Закрытие let и cond.
                    })))
;       [361] Закрытие let / progn.
        }))
; [362] Конец функции.
})


; -----------------------------------------------------------------------------
;  БЛОК 5. АНТИПРОБУКСОВКА (шаблон, СЕЙЧАС НЕ ЗАПУЩЕНА)
;
;  Функция определена, но spawn для неё внизу файла нет, а tc-on всегда 0 — на
;  одномоторной машине толку мало. Оставлена как готовый образец.
; -----------------------------------------------------------------------------

; [363] Поток контроля пробуксовки: ловит слишком резкий прирост ERPM.
(defun monitor-traction () {
;   [364] Локальная память прошлых оборотов (живёт всё время жизни потока).
    (let ((last-erpm 0.0)) {
;       [365] Вечный цикл.
        (loopwhile t {
;           [366] Работаем только когда TC включён.
            (if (= tc-on 1) {
;               [367] Текущие обороты.
                (let ((erpm (get-rpm))) {
;                   [368] Прирост модуля оборотов за один тик (20 мс) = «ускорение».
                    (let ((accel (- (abs erpm) (abs last-erpm)))
;                       [369] Порог: чувствительность 0 → 5000, 100 → 1000
;                           (чем больше tc-sens, тем раньше срабатывает).
                          (limit (- 5000.0 (* tc-sens 40.0)))) {
;                       [370] Превысили порог — грубо срезаем ток в ноль.
                        (if (> accel limit) (set-current 0))
;                   [371] Закрытие let accel/limit.
                    })
;                   [372] Запоминаем обороты для следующего тика.
                    (setq last-erpm erpm)
;               [373] Закрытие let erpm.
                })
;           [374] Иначе (TC выключён)...
            } {
;               [375] ...всё равно обновляем историю, чтобы при включении не
;                   получить огромный «скачок» из устаревшего значения.
                (setq last-erpm (get-rpm))
;           [376] Закрытие if.
            })
;           [377] 50 Гц — TC должен быть быстрее арбитра по реакции.
            (sleep 0.02)
;       [378] Конец цикла.
        })
;   [379] Закрытие let last-erpm.
    })
; [380] Конец функции.
})


; -----------------------------------------------------------------------------
;  БЛОК 6. АРБИТР МОТОРА — САМАЯ ВАЖНАЯ ЧАСТЬ
; -----------------------------------------------------------------------------

; [381] Ограничить v диапазоном [lo, hi]. Базовый хелпер, используется везде.
(defun clampf (v lo hi) (if (< v lo) lo (if (> v hi) hi v)))

; [382] (комментарий оригинала) Тянуть v к target: вверх со скоростью 1/pos-s
;     в секунду, вниз — 1/neg-s в секунду.

; [383] Ограничитель скорости изменения (slew limiter) — «рампа».
(defun slew (v target pos-s neg-s)
;   [384] Если цель выше текущего...
    (if (> target v)
;       [385] ...прибавляем шаг за тик (ctl-dt/pos-s) и не перескакиваем цель
;           (clampf сверху именно target, снизу 0).
        (clampf (+ v (/ ctl-dt pos-s)) 0.0 target)
;       [386] Иначе снижаемся шагом ctl-dt/neg-s, не проскакивая цель снизу.
        (clampf (- v (/ ctl-dt neg-s)) target 1.0)))

; [387-390] (комментарий оригинала) Времена рамп берём ЖИВЬЁМ со страницы ADC
;     App в VESC Tool (App Settings → ADC → Ramping Time Positive/Negative) —
;     это те же ручки, что формировали штатный газ, поэтому настройка остаётся
;     в VESC Tool и применяется мгновенно. Зажаты подальше от нуля, чтобы ноль
;     в конфиге не устроил деление на ноль и не убил поток арбитра.

; [391] Время нарастания, с (0.05..5).
(defun ramp-pos () (clampf (conf-get 'adc-ramp-time-pos) 0.05 5.0))

; [392] Время спада, с (0.05..5).
(defun ramp-neg () (clampf (conf-get 'adc-ramp-time-neg) 0.05 5.0))

; [393-398] (комментарий оригинала) Выход газа: сначала кривая в стиле VESC
;     Tool, потом рампа к цели (заменяет рампинг ADC-приложения), потом
;     ОТНОСИТЕЛЬНЫЙ ток — он живьём масштабируется на l-current-max × профиль
;     и на тепловое ограничение, поэтому смена Motor Current Max в VESC Tool
;     действует немедленно. Отпущенный газ (thr <= 0.05) съезжает вниз по той
;     же рампе — арбитр продолжает звать эту функцию, пока out-rel не дойдёт до
;     нуля, вместо мгновенного обрыва тока.

; [399] Отработать положение газа thr (0..1 после калибровки ADC).
(defun throttle-out (thr) {
;   [400] Цель: если газ нажат больше мёртвой зоны 5%...
    (let ((target (if (> thr 0.05)
;       [401] ...прогоняем через кривую газа (accel-константа, brake-константа 0,
;           режим кривой)...
                      (throttle-curve thr thr-curve-accel 0.0 thr-curve-mode)
;       [402] ...иначе цель — ноль (отпущен).
                      0.0)))
;       [403] Двигаем текущий выход к цели по рампе (сохраняя состояние out-rel).
        (setq out-rel (slew out-rel target (ramp-pos) (ramp-neg))))
;   [404] Командуем относительный ток. Второй аргумент 0.2 — таймаут команды в
;       секундах: если новых команд не будет, прошивка сама снимет ток через
;       200 мс (страховка от «зависшего» скрипта).
    (set-current-rel out-rel 0.2)
; [405] Конец функции.
})

; [406-408] (комментарий оригинала) Тормоз — та же форма и те же времена рамп
;     (штатное ADC-приложение тоже рампило тормоз): схват ручки — быстрая рампа,
;     а не мгновенный удар рекуперацией, отпускание — плавный сход, а не шаг в 0.

; [409] Отработать положение тормоза brk (0..1).
(defun brake-out (brk) {
;   [410] Цель: сам brk, если выше мёртвой зоны, иначе 0.
    (let ((target (if (> brk 0.05) brk 0.0)))
;       [411] Рампа к цели, состояние — в brk-rel.
        (setq brk-rel (slew brk-rel target (ramp-pos) (ramp-neg))))
;   [412] Относительное торможение (доля от лимита тормозного тока). Профилями
;       НЕ масштабируется — тормоз всегда полный.
    (set-brake-rel brk-rel)
; [413] Конец функции.
})

; [414-417] (комментарий оригинала) Выход круиза: PI по ошибке ERPM → ток.
;     Интегратор зажат (anti-windup) живым лимитом (l-current-max × масштаб
;     профиля, оба читаются заново каждый тик, поэтому правка в VESC Tool или
;     смена профиля применяются сразу; прошивка сверху ещё режет по нагреву).
;     Учитывает знак — круиз работает и задним ходом.

; [418] Один тик PI-регулятора круиза.
(defun cruise-out () {
;   [419] Ошибка = целевые обороты − фактические.
    (let ((err (- cruise-rpm (get-rpm)))
;       [420] Живой потолок тока = максимум × масштаб профиля.
          (imax (* (conf-get 'l-current-max) (conf-get 'l-current-max-scale)))) {
;       [421] Движение вперёд (целевые обороты >= 0)...
        (if (>= cruise-rpm 0) {
;           [422] Интегрируем ошибку (ki × err × dt) и зажимаем в [0, imax].
            (setq cruise-i (clampf (+ cruise-i (* cruise-ki err ctl-dt)) 0.0 imax))
;           [423] Выход = P + I, тоже зажат; 0.2 — таймаут команды.
            (set-current (clampf (+ (* cruise-kp err) cruise-i) 0.0 imax) 0.2)
;       [424] Иначе — задний ход, всё зеркально по знаку...
        } {
;           [425] ...интегратор зажат в [-imax, 0]...
            (setq cruise-i (clampf (+ cruise-i (* cruise-ki err ctl-dt)) (- imax) 0.0))
;           [426] ...и выход тоже отрицательный.
            (set-current (clampf (+ (* cruise-kp err) cruise-i) (- imax) 0.0) 0.2)
;       [427] Закрытие if по знаку.
        })
;   [428] Закрытие let.
    })
; [429] Конец функции.
})

; [430-437] (комментарий оригинала) ЭТО — арбитр мотора, единственное место,
;     откуда идут команды на мотор. Штатное ADC-приложение остаётся
;     сконфигурированным (его поток продолжает декодировать ручки газа/тормоза
;     для get-adc-decoded, а VESC Tool сохраняет свой UI калибровки), но его
;     ВЫХОД подавляется «скользящим» запретом на 1.5 с, который этот цикл всё
;     время продлевает. Если скрипт умрёт: мотор встанет по таймауту команд
;     (каждый set-* здесь его кормит), а примерно через 1.5 с вернётся штатный
;     газ ADC — байк останется управляемым (без круиза и PAS), а не «кирпичом».
;     Приоритет: мастер-выкл > тормоз > газ > круиз > PAS > накат.

; [438] Главный цикл управления мотором, 100 Гц.
(defun motor-control-loop () {
;   [439] Вечный цикл.
    (loopwhile t {
;       [440] Продлеваем запрет вывода штатного приложения ещё на 1500 мс. Так
;           как тик 10 мс, запрет никогда не истечёт, пока скрипт жив.
        (app-disable-output 1500)
;       [441] Читаем декодированное положение газа (канал 0), 0..1 — с учётом
;           калибровки и мёртвых зон, настроенных в VESC Tool.
        (let ((thr   (get-adc-decoded 0))
;           [442] И тормоза (канал 1).
              (brake (get-adc-decoded 1))) {
;           [443-444] (комментарий оригинала) Безопасный старт: никакого выхода,
;               пока газ хоть раз не увидели отпущенным (защита от зажатой ручки
;               в момент запуска скрипта).
;           [445] Газ отпущен → «взводим» систему.
            (if (< thr 0.05) (setq armed 1))
;           [446] Пока не взведено — считаем газ нулевым.
            (if (= armed 0) (setq thr 0.0))
;           [447-449] (комментарий оригинала) Ветка остаётся выбранной, пока её
;               рампа доезжает до нуля (out-rel / brk-rel > 0) — поэтому
;               отпускание газа или тормоза плавно сходит на нет, а не рубит ток.
;           [450] Приоритетный выбор источника команды.
            (cond
;               [451] 0. Мастер-выключатель выключен — едем накатом.
                ((= throttle-on 0) {          ; panel master switch — coast
;                   [452] Сбрасываем состояние рампы газа...
                    (setq out-rel 0.0)
;                   [453] ...и тормоза (иначе после включения они «доедут» из
;                       старых значений).
                    (setq brk-rel 0.0)
;                   [454] Ток 0 — свободный накат.
                    (set-current 0) })
;               [455] 1. Тормоз: либо ручка нажата, либо рампа ещё сходит.
                ((or (> brake 0.05) (> brk-rel 0.001)) {  ; 1. brake
;                   [456] Реальное нажатие тормоза выключает круиз.
                    (if (> brake 0.05) (deactivate-cruise-control))
;                   [457] Под тормозом газ обнуляем мгновенно — это безопасно.
                    (setq out-rel 0.0)        ; throttle cut is fine under brake
;                   [458] Тормозим (в полную силу, без масштаба профиля).
                    (brake-out brake) })      ; full range, never profile-scaled
;               [459] 2. Газ: нажат либо рампа ещё сходит вниз.
                ((or (> thr 0.05) (> out-rel 0.001)) {    ; 2. throttle
;                   [460] Реальное нажатие газа выключает круиз.
                    (if (> thr 0.05) (deactivate-cruise-control))
;                   [461] Отдаём мотор газу.
                    (throttle-out thr) })
;               [462] 3. Круиз — если включён и никто выше не претендует.
                ((= cruise-active 1)          ; 3. cruise (PI → current)
;                   [463] Один тик PI-регулятора.
                    (cruise-out))
;               [464] 4. Педалирование: есть положительная уставка...
                ((and (> pas-amps 0.0)        ; 4. pedal assist from head unit
;                   [465] ...и она свежая (моложе 0.4 с).
                      (< (secs-since pas-seen) 0.4))
;                   [466-467] (комментарий оригинала) Протухшая уставка (сдох
;                       датчик или связь) проваливается в накат — P4 к тому же
;                       сам присылает явный ноль.
;                   [468] Командуем запрошенный ток; прошивка сама зажмёт его
;                       по lo_current_max. 0.2 — таймаут команды.
                    (set-current pas-amps 0.2))  ; fw clamps to lo_current_max
;               [469] 5. Никто ничего не хочет — накат.
                (t                            ; 5. coast
;                   [470] Ток 0 (и это тоже кормит таймаут команд).
                    (set-current 0)))
;       [471] Закрытие let thr/brake.
        })
;       [472] Спим период тика — 10 мс.
        (sleep ctl-dt)
;   [473] Конец цикла.
    })
; [474] Конец функции.
})


; -----------------------------------------------------------------------------
;  БЛОК 7. СОХРАНЕНИЕ НАСТРОЕК И КНОПКИ BLE-ХЕЛПЕРА
; -----------------------------------------------------------------------------

; [475] Обработчик выключения питания: последний шанс записать громкость.
(defun panel-on-shutdown () {
;   [476] Пишем только если есть несохранённое изменение.
    (if (= beep-vol-dirty 1) {
;       [477] Просим прошивку придержать выключение, пока пишем во флеш.
        (shutdown-hold t)
;       [478] Записываем громкость в EEPROM.
        (eeprom-store-i beep-vol-addr beep-vol)
;       [479] Снимаем флаг «грязно».
        (setq beep-vol-dirty 0)
;       [480] Отпускаем удержание — можно выключаться.
        (shutdown-hold nil)
;   [481] Закрытие if.
    })
; [482] Конец функции.
})

; [483-488] (комментарий оригинала) Громкость меняется слайдером панели (за один
;     драг — куча промежуточных значений) и должна переживать перезагрузку.
;     Сохранять ТОЛЬКО в panel-on-shutdown оказалось ненадёжно: event-shutdown
;     приходит лишь при настоящем выключении питания, а не при перезагрузке на
;     столе / по USB / при перепрошивке — и eeprom-store-i просто не вызывался.
;     Поэтому сбрасываем «грязное» значение медленным таймером: драг схлопывается
;     примерно в одну запись во флеш и не зависит от чистого выключения.
;     panel-on-shutdown остаётся финальным сбросом.

; [489] Фоновый поток отложенной записи настроек.
(defun persist-volumes-loop () {
;   [490] Вечный цикл.
    (loopwhile t {
;       [491] Есть несохранённое изменение?
        (if (= beep-vol-dirty 1) {
;           [492] Пишем и снимаем флаг.
            (eeprom-store-i beep-vol-addr beep-vol) (setq beep-vol-dirty 0) })
;       [493] (закрытие if — на той же строке оригинала)
;       [494] Проверяем раз в 2 секунды: этого хватает, чтобы не потерять
;           настройку, и мало, чтобы не изнашивать флеш.
        (sleep 2)
;   [495] Конец цикла.
    })
; [496] Конец функции.
})

; [497-502] (комментарий оригинала) Кастомные кадры кнопок от BLE-хелпера: это
;     обычные CAN-кадры со стандартным id, id и данные настраиваются на кнопку
;     в GUI хелпера. Команда = байты данных, прочитанные как big-endian u16
;     (однобайтовые кадры тоже работают):
;       CAN ID 0x123, данные 00 01 (кнопка A) -> переключить мастер-выключатель газа
;       CAN ID 0x123, данные 00 02 (кнопка B) -> переключить профиль (apply-profile
;                                                при этом пикнет по профилю)
;       что угодно ещё                        -> просто печатается; свои команды
;                                                добавляй ниже

; [503] CAN-id, на который реагируем. Должен совпасть с настройкой в хелпере.
(def helper-btn-id 0x123)

; [504] Обработчик кадра кнопки хелпера.
(defun proc-helper-btn (data) {
;   [505] Команда: если байт хотя бы два...
    (let ((cmd (if (>= (buflen data) 2)
;       [506] ...читаем u16 big-endian...
                   (bufget-u16 data 0)
;       [507] ...иначе одиночный байт.
                   (bufget-u8 data 0)))) {
;       [508] Разбор команды.
        (cond
;           [509] Команда 1 — переключить газ.
            ((= cmd 1) {
;               [510] Инвертируем состояние.
                (panel-set-throttle (if (= throttle-on 1) 0 1))
;               [511] Лог...
                (print (str-merge "helper: throttle "
;               [512] ...с УЖЕ НОВЫМ состоянием (panel-set-throttle отработал выше).
                                  (if (= throttle-on 1) "ON" "off")))
;           [513] Закрытие ветки.
            })
;           [514] Команда 2 — следующий профиль.
            ((= cmd 2) {
;               [515] Циклим профиль (с бипом-подтверждением).
                (switch-profile)
;               [516] Лог...
                (print (str-merge "helper: profile "
;               [517] ...с номером нового профиля.
                                  (to-str current-profile)))
;           [518] Закрытие ветки.
            })
;           [519] Всё остальное — печатаем код, чтобы было легко подобрать данные
;               кнопки в GUI хелпера и потом добавить сюда свою ветку.
            (t (print (str-merge "helper cmd " (to-str cmd)))))
;   [520] Закрытие let.
    })
; [521] Конец функции.
})

; [522] Единый цикл обработки событий: панель, CAN-кнопки, выключение питания.
;     Один поток на все события — так они не гоняются друг с другом за буфер pbuf.
(defun panel-event-loop () {
;   [523] Вечный цикл.
    (loopwhile t {
;       [524] recv блокирует поток до события. Событие «пришли данные»
;           (COMM_CUSTOM_APP_DATA) → в разбор панели.
        (recv ((event-data-rx . (? data)) (panel-handle data))
;             [525] Событие «пришёл CAN-кадр со стандартным id»: сопоставляем
;                 и id, и данные.
              ((event-can-sid (? id) . (? data))
;                 [526] Реагируем только на кадры с нашего id хелпера.
;                 ВНИМАНИЕ: чтобы эта ветка вообще срабатывала, внизу файла нужен
;                 (event-enable 'event-can-sid) — сейчас его там нет, включены
;                 только event-data-rx и event-shutdown.
                  (if (= id helper-btn-id) (proc-helper-btn data)))
;             [527] Событие выключения питания → финальный сброс настроек.
              (event-shutdown               (panel-on-shutdown))
;             [528] Заглушка: любое другое событие молча игнорируем (без неё
;                 recv в LispBM ругался бы на несовпадение шаблона).
              (_ nil))
;   [529] Конец цикла.
    })
; [530] Конец функции.
})

; [531] (пустая строка в оригинале)


; -----------------------------------------------------------------------------
;  БЛОК 8. ЗАПУСК — СТРОГО В КОНЦЕ
; -----------------------------------------------------------------------------

; [532-537] (комментарий оригинала) Потоки и включение событий — В САМОМ КОНЦЕ,
;     после того как связаны все функции, до которых они могут дотянуться:
;     panel-event-loop → panel-handle → panel-action → panel-set-profile. Запусти
;     раньше — и команда с панели, прилетевшая во время загрузки, попадёт в ещё
;     несвязанную функцию → поток обработчика умрёт → панель мертва.
;     Это обычные выражения, а не определения, поэтому @const-start их не
;     «прошивает» — они просто выполняются здесь, что нам и нужно.

; [538] Запускаем цикл событий и регистрируем его как получателя системных
;     событий (event-register-handler принимает id потока, который вернул spawn).
(event-register-handler (spawn panel-event-loop))

; [539] Включаем доставку события «пришли данные приложения» — это транспорт
;     панели (COMM_CUSTOM_APP_DATA).
(event-enable 'event-data-rx)

; [540] Включаем событие выключения питания — для финальной записи настроек.
;     (Кадры CAN-кнопок хелпера потребовали бы ещё (event-enable 'event-can-sid).)
(event-enable 'event-shutdown)

; [541] Поднимаем поток отложенной записи громкости.
(spawn 150 persist-volumes-loop)

; [542] И, последним, арбитр мотора — с этого момента мотором управляет скрипт,
;     а выход штатного ADC-приложения подавлен.
(spawn 150 motor-control-loop)

; [543] Конец «флешируемой» области. Всё, что определено между @const-start и
;     @const-end, лежит во флеше и не занимает кучу.
@const-end
